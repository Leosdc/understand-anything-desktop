{
  "name": "@understand-anything/desktop",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "main": "dist/main/electron.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/electron.ts --bundle --platform=node --target=node22 --external:electron --outfile=dist/main/electron.cjs --format=cjs && esbuild src/main/preload.ts --bundle --platform=node --target=node22 --external:electron --outfile=dist/main/preload.cjs --format=cjs && node scripts/copy-assets.js",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run build:main\" \"electron .\"",
    "build": "npm run build:renderer && npm run build:main && electron-packager . \"Understand Anything\" --platform=win32 --arch=x64 --out=dist-package --overwrite --no-prune --ignore=\"^/(node_modules|temp-plugin|packages|dist-package|src|dashboard|skills|docs|scripts|assets|\\.github|\\.git)($|/)\""
  },
  "build": {
    "appId": "com.understandanything.desktop",
    "productName": "Understand Anything",
    "win": {
      "target": "dir"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-package"
    }
  },
  "dependencies": {
    "express": "^4.21.2",
    "fuse.js": "^7.1.0",
    "graphology": "~0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "ignore": "^7.0.5",
    "lucide-react": "^0.470.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.23.11",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.6",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^10.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.2"
  }
}
